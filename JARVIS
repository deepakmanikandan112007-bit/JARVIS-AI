from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.clock import Clock
from kivy.graphics import Color, Ellipse
from kivy.core.window import Window

Window.clearcolor = (0, 0, 0, 1)

GREEN = (0, 1, 0.5, 1)

class JarvisApp(App):

    def build(self):
        layout = BoxLayout(
            orientation="vertical",
            padding=25,
            spacing=20
        )

        title = Label(
            text="[b]J.A.R.V.I.S[/b]",
            markup=True,
            font_size="36sp",
            color=GREEN,
            size_hint=(1, 0.2)
        )

        self.status = Label(
            text="SYSTEM ONLINE",
            color=GREEN,
            font_size="18sp"
        )

        self.reactor = Label(
            text="◎",
            font_size="130sp",
            color=GREEN
        )

        hello = Label(
            text="HELLO! I AM JARVIS",
            color=GREEN,
            font_size="20sp"
        )

        button = Button(
            text="ACTIVATE JARVIS",
            font_size="20sp",
            background_normal="",
            background_color=(0, 0.15, 0.07, 1),
            color=GREEN,
            size_hint=(1, 0.15)
        )

        button.bind(on_press=self.activate)

        layout.add_widget(title)
        layout.add_widget(self.status)
        layout.add_widget(self.reactor)
        layout.add_widget(hello)
        layout.add_widget(button)

        return layout

    def activate(self, instance):
        self.status.text = "JARVIS ACTIVATED"
        instance.text = "SYSTEM READY"

JarvisApp().run()
